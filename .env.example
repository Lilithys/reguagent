# Optional live mode. Offline demo needs no key.
# Copy to .env.local; never commit the populated file.
LLM_PROVIDER="openai"
LLM_API_KEY=""
LLM_MODEL="gpt-5"

# For an Anthropic-Messages-compatible service, replace the configuration above:
# LLM_PROVIDER="anthropic"
# LLM_API_KEY=""
# LLM_BASE_URL="https://your-compatible-endpoint.example"
# LLM_MODEL="your-model-id"
